namespace my_crate {};

enum PasswordValidation {
  "TooShort",
  "TooLong",
  "NoUppercase",
  "NoLowercase",
  "NoNumber",
  "NoSymbol",
  "Valid",
};

// User Domain Layer - exposed for platform ViewModels
record ErrorDisplay {
    string title;
    string subtitle;
}

record UserDomainModel {
    u64 id;
    string first_name;
    string last_name;
    string phone;
    string full_name;
    string image_url;
    string age_display;
    string email_display;
}

// Single result model for all user domain operations
// Always returns Vec<UserDomainModel> for Loaded case
// Empty case uses EpmtyDataModel, Error case uses ErrorDisplay
// Platforms check the variant instead of using try/catch
record EpmtyDataModel {
    string title;
    string subtitle;
    string button_title;
}

enum UserDomainResultModel {
    Loaded { data sequence<UserDomainModel> data };
    Empty { data EpmtyDataModel data };
    Error { record ErrorDisplay display };
}

object GetUsersUseCaseImpl {
    constructor();
    async UserDomainResultModel execute();
};
