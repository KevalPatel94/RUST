namespace my_crate {};

enum PasswordValidation {
  "TooShort",
  "TooLong",
  "NoUppercase",
  "NoLowercase",
  "NoNumber",
  "NoSymbol",
  "Valid",
};

// User Domain Layer - exposed for platform ViewModels
enum DomainError {
    Error { record ErrorDisplay display };
}

record ErrorDisplay {
    string title;
    string subtitle;
}

record UserDomainModel {
    u64 id;
    string first_name;
    string last_name;
    string email;
    string phone;
    u32 age;
    string full_name;
}

object GetUsersUseCaseImpl {
    constructor() throws DomainError;
    async Result<sequence<UserDomainModel>, DomainError> execute();
    async Result<UserDomainModel, DomainError> execute_by_id(u64 id);
    // Convert DomainError to ErrorDisplay - platforms just need title/subtitle
    ErrorDisplay to_error_display(DomainError error);
};
